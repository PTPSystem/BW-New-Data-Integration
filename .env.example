# Beachwood Data Integration - Environment Variables
# Copy this file to .env and fill in your values for local development
# NEVER commit .env with actual secrets to git!

# ===================================================
# Environment Configuration
# ===================================================
ENVIRONMENT=dev  # Options: dev, staging, production

# ===================================================
# Azure Authentication (for Key Vault access)
# ===================================================
# Option 1: Use Azure CLI (recommended for local dev)
#   Just run: az login
#   Then comment out the credentials below

# Option 2: Use Service Principal (for containers/CI/CD)
AZURE_TENANT_ID=c8b6ba98-3fc0-4153-83a9-01374492c0f5
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ===================================================
# Logging Configuration
# ===================================================
LOG_LEVEL=DEBUG  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===================================================
# Optional: Override OLAP Configuration
# (Otherwise loaded from Key Vault)
# ===================================================
OLAP_SERVER=https://ednacubes.papajohns.com:10502
OLAP_CATALOG=OARS Franchise
OLAP_USERNAME=your_olap_username_here
OLAP_PASSWORD=your_olap_password_here
OLAP_SSL_VERIFY=false

# ===================================================
# Neon Postgres — ETL write target
# ===================================================
# Dedicated Neon project (created separately; do not commit a real password).
# Prefer the direct, non-pooler host for this long-running load.
# sslmode=require is added automatically when it is missing.
# Placeholder only — replace <role>, <password>, <endpoint>, <region>, and <database>.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Dataverse credentials are not set here. Historical backfill and the
# sales-forecast / labor store-list reads still use Azure Key Vault
# (app-client-id, app-client-secret, azure-tenant-id).

# ===================================================
# Optional: Override SharePoint Configuration
# (Otherwise loaded from Key Vault)
# ===================================================
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://netorgft3835860.sharepoint.com/sites/ITProject
SHAREPOINT_TENANT_ID=your-tenant-id

# ===================================================
# Testing Configuration
# ===================================================
# PYTEST_ARGS=--cov=modules --cov-report=html

# ===================================================
# Notes
# ===================================================
# 1. All secrets are stored in Azure Key Vault: kv-bw-data-integration
# 2. App Registration: ar-bw-data-integration (d056223e-f0de-4b16-b4e0-fec2a24109ff)
# 3. Key Vault contains 10 secrets: app-client-id, app-client-secret, azure-tenant-id,
#    dataverse-client-id, files-password, files-url, files-username, olap-password,
#    olap-username, sharepoint-site-url
# 4. Environment variables here are only for local development override
# 5. In production, only AZURE_* credentials should be set (everything else from Key Vault)
# 6. Never commit .env file to git (it's in .gitignore)
